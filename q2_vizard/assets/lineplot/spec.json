{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "title": {
    "text": {"signal": "title"},
    "fontSize": 20,
    "orient": "top",
    "anchor": "start",
    "subtitle": {
      "signal": "[subtitle, ' ', suppressMarks ? 'NOTE: Actual data marks have been suppressed.' : ' ', ' ']"
    },
    "subtitlePadding": 30,
    "subtitleFontSize": 16
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 120,

  "signals": [
    {
      "name": "width",
      "init": "isFinite(containerSize()[0]) ? containerSize()[0] : 300",
      "on": [
        {
          "update": "isFinite(containerSize()[0]) ? containerSize()[0] : 300",
          "events": "window:resize"
        }
      ]
    },
    {
      "name": "height",
      "init": "isFinite(containerSize()[1]) ? containerSize()[1] : 600",
      "on": [
        {
          "update": "isFinite(containerSize()[1]) ? containerSize()[1] : 600",
          "events": "window:resize"
        }
      ]
    },
    {
      "name": "unit",
      "value": {},
      "on": [
        {
          "events": "mousemove",
          "update": "isTuple(group()) ? group() : unit"
        }
      ]
    },
    {
      "name": "grid_value_x",
      "on": [
        {
          "events": [
            {"source": "view", "type": "dblclick"},
            {"signal": "includeZero"}
          ],
          "update": "null"
        },
        {
          "events": {"signal": "grid_translate_delta_x"},
          "update": "panLinear(grid_translate_anchor.extent_x, -grid_translate_delta_x.x / width)"
        },
        {
          "events": {"signal": "grid_zoom_delta"},
          "update": "zoomLinear(domain(\"x_scale\"), grid_zoom_anchor_x.x, grid_zoom_delta)"
        }
      ]
    },
    {
      "name": "grid_value_y",
      "on": [
        {
          "events": [
            {"source": "view", "type": "dblclick"},
            {"signal": "includeZero"}
          ],
          "update": "null"
        },
        {
          "events": {"signal": "grid_translate_delta_y"},
          "update": "panLinear(grid_translate_anchor.extent_y, grid_translate_delta_y.y / height)"
        },
        {
          "events": {"signal": "grid_zoom_delta"},
          "update": "zoomLinear(domain(\"y_scale\"), grid_zoom_anchor_y.y, grid_zoom_delta)"
        }
      ]
    },
    {
      "name": "grid_translate_anchor",
      "value": {},
      "on": [
        {
          "events": [{"source": "view", "type": "mousedown"}],
          "update": "{x: x(unit), extent_x: domain(\"x_scale\"), y: y(unit), extent_y: domain(\"y_scale\")}"
        }
      ]
    },
    {
      "name": "grid_translate_delta_x",
      "value": {},
      "on": [
        {
          "events": [
            {
              "source": "window",
              "type": "mousemove",
              "consume": true,
              "between": [
                {"source": "view", "type": "mousedown"},
                {"source": "window", "type": "mouseup"}
              ]
            }
          ],
          "update": "{x: grid_translate_anchor.x - x(unit)}"
        }
      ]
    },
    {
      "name": "grid_translate_delta_y",
      "value": {},
      "on": [
        {
          "events": [
            {
              "source": "window",
              "type": "mousemove",
              "consume": true,
              "between": [
                {"source": "view", "type": "mousedown"},
                {"source": "window", "type": "mouseup"}
              ]
            }
          ],
          "update": "{y: grid_translate_anchor.y - y(unit)}"
        }
      ]
    },
    {
      "name": "grid_zoom_anchor_x",
      "on": [
        {
          "events": [
            {
              "source": "view",
              "type": "wheel",
              "consume": true
            }
          ],
          "update": "{x: invert(\"x_scale\", x(unit))}"
        }
      ]
    },
    {
      "name": "grid_zoom_anchor_y",
      "on": [
        {
          "events": [
            {
              "source": "view",
              "type": "wheel",
              "consume": true
            }
          ],
          "update": "{y: invert(\"y_scale\", y(unit))}"
        }
      ]
    },
    {
      "name": "grid_zoom_delta",
      "on": [
        {
          "events": [
            {
              "source": "view",
              "type": "wheel",
              "consume": true
            }
          ],
          "force": true,
          "update": "pow(1.001, event.deltaY * pow(16, event.deltaMode))"
        }
      ]
    },
    {
      "name": "subtitle",
      "value": {"{{REPLACE_PARAM}}": "subtitle"}
    },
    {
      "name": "idField",
      "value": {"{{REPLACE_PARAM}}": "md_ids"}
    },
    {
      "name": "xField",
      "value": {"{{REPLACE_PARAM}}": "x_measure"}
    },
    {
      "name": "title",
      "value": {"{{REPLACE_PARAM}}": "title"},
      "bind": {"input": "input"}
    },
    {
      "name": "yField",
      "value": {"{{REPLACE_PARAM}}": "y_dropdown_default"},
      "bind": {
        "input": "select",
        "options": {"{{REPLACE_PARAM}}": "md_cols_numeric"}
      }
    },
    {
      "name": "lineType",
      "value": "linear",
      "bind": {
        "input": "select",
        "options": ["linear", "step"]
      }
    },
    {
      "name": "markSize",
      "value": 150,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 800
      }
    },
    {
      "name": "suppressMarks",
      "value": false,
      "bind": {"input": "checkbox"}
    },
    {
      "name": "strokeWidth",
      "value": 2.5,
      "bind": {
        "input": "range",
        "min": 0.5,
        "max": 5
      }
    },
    {
      "name": "includeZero",
      "value": true,
      "bind": {"input": "checkbox"}
    },
    {
      "name": "colorPalette",
      "value": "category10",
      "bind": {
        "input": "select",
        "options": [
          "Viridis", "Cividis", "Plasma", "Turbo",
          "category10", "dark2", "set1", "tableau10"
        ]
      }
    }
  ],

  "data": [
    {
      "name": "scatter_table",
      "values": {"{{REPLACE_PARAM}}": "metadata"}
    },
    {
      "name": "line_table",
      "values": {"{{REPLACE_PARAM}}": "averaged_metadata"}
    }
  ],

  "scales": [
    {
      "name": "x_scale",
      "type": "linear",
      "range": "width",
      "nice": true,
      "zero": {"signal": "includeZero"},
      "domainRaw": {"signal": "grid_value_x"},
      "domain": {
        "data": "scatter_table",
        "field": {"{{REPLACE_PARAM}}": "x_measure"}
      }
    },
    {
      "name": "y_scale",
      "type": "linear",
      "range": "height",
      "nice": true,
      "zero": {"signal": "includeZero"},
      "domainRaw": {"signal": "grid_value_y"},
      "domain": {
        "data": "scatter_table",
        "field": {"signal": "yField"}
      }
    },
    {
      "name": "color_scale",
      "type": "ordinal",
      "range": {
        "scheme": {"signal": "colorPalette"}
      },
      "domain": {
        "data": "line_table",
        "field": {"{{REPLACE_PARAM}}": "group_by"},
        "sort": true
      }
    }
],

"axes": [
    {
      "scale": "x_scale",
      "grid": true,
      "orient": "bottom",
      "tickCount": 5,
      "title": {"{{REPLACE_PARAM}}": "x_measure"},
      "titleFontSize": 18,
      "titlePadding": 20,
      "labelFontSize": 16,
      "labelPadding": 15
    },
    {
      "scale": "y_scale",
      "grid": true,
      "orient": "left",
      "title": {"signal": "yField"},
      "titleFontSize": 18,
      "titlePadding": 20,
      "labelFontSize": 16,
      "labelPadding": 15
    }
  ],

  "legends": [
    {
      "offset": 35,
      "fill": "color_scale",
      "symbolSize": 150,
      "symbolStrokeWidth": 1.5,
      "labelFontSize": 14,
      "title": {"{{REPLACE_PARAM}}": "group_by"},
      "titleFontSize": 16,
      "encode": {
        "symbols": {
          "name": "legendSymbol",
          "interactive": false,
          "update": {
            "stroke": {"value": "black"}
          }
        },
        "labels": {
          "name": "legendLabel",
          "interactive": false
        }
      }
    }
  ],

  "marks": [
    {
      "type": "group",
      "clip": true,
      "from": {
        "facet": {
          "name": "lines",
          "data": "line_table",
          "groupby": {"{{REPLACE_PARAM}}": "group_by"}
        }
      },
      "marks": [
        {
          "type": "line",
          "from": {"data": "lines"},
          "sort": {"field": "x"},
          "encode": {
            "update": {
              "x": {
                "scale": "x_scale",
                "field": {"{{REPLACE_PARAM}}": "x_measure"}
              },
              "y": {
                "scale": "y_scale",
                "field": {"signal": "yField"}},
              "interpolate": {"signal": "lineType"},
              "stroke": {
                "scale": "color_scale",
                "field": {"{{REPLACE_PARAM}}": "group_by"}
              },
              "strokeWidth": {"signal": "strokeWidth"},
              "strokeOpacity": {"value": 1}
            }
          }
        }
      ]
    },
    {
      "type": "symbol",
      "clip": true,
      "from": {"data": "scatter_table"},
      "encode": {
        "update": {
          "x": {
            "scale": "x_scale",
            "field": {"{{REPLACE_PARAM}}": "x_measure"}
          },
          "y": {
            "scale": "y_scale",
            "field": {"signal": "yField"}
          },
          "shape": {"value": "circle"},
          "stroke": {"value": "black"},
          "strokeWidth": {"value": 1.5},
          "size": {"signal": "markSize"},
          "opacity": {"signal": "suppressMarks ? 0 : 1" },
          "fill": {
            "scale": "color_scale",
            "field": {"{{REPLACE_PARAM}}": "group_by"}
          }
        },
        "hover": {
          "strokeWidth": {"value": 2.5},
          "tooltip": {"signal": "datum"}
        }
      }
    }
  ]
}
