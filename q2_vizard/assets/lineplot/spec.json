{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "title": {
    "text": {"signal": "title"},
    "fontSize": 20,
    "orient": "top",
    "anchor": "start",
    "subtitle": {"{{REPLACE_PARAM}}": "subtitle"},
    "subtitlePadding": 30
  },
  "autosize": {"type": "pad"},
  "width": 900,
  "height": 900,
  "padding": 20,

  "signals": [
    {
      "name": "width",             
      "init": "containerSize()[0]"
    },
    {
      "name": "height",
      "init": "containerSize()[1]"
    },
    {
      "name": "subtitle",
      "value": {"{{REPLACE_PARAM}}": "subtitle"}
    },
    {
      "name": "idField",
      "value": {"{{REPLACE_PARAM}}": "md_ids"}
    },
    {
      "name": "xField",
      "value": {"{{REPLACE_PARAM}}": "x_measure"}
    },
    {
      "name": "title",
      "value": {"{{REPLACE_PARAM}}": "title"},
      "bind": {"input": "input"}
    },
    {
      "name": "yField",
      "value": {"{{REPLACE_PARAM}}": "y_dropdown_default"},
      "bind": {
        "input": "select",
        "options": {"{{REPLACE_PARAM}}": "md_cols_numeric"}
      }
    },
    {
      "name": "lineType",
      "value": "linear",
      "bind": {
        "input": "select",
        "options": ["linear", "step"]
      }
    },
    {
      "name": "markSize",
      "value": 150,
      "bind": {
        "input": "range",
        "min": 150,
        "max": 800
      }
    },
    {
      "name": "includeZero",
      "value": true,
      "bind": {"input": "checkbox"}
    },
    {
      "name": "colorPalette",
      "value": "Viridis",
      "bind": {
        "input": "select",
        "options": [
          "Viridis", "Cividis", "Plasma", "Turbo",
          "category10", "dark2", "set1", "tableau10"
        ]
      }
    },
    {
      "name": "xoffset",
      "update": "-(height + padding.bottom)"
    },
    {
      "name": "yoffset",
      "update": "-(width + padding.left)"
    },
    {
      "name": "xrange",
      "update": "[0, width]"
    },
    {
      "name": "yrange",
      "update": "[height, 0]"
    },
    {
      "name": "down",
      "value": null,
      "on": [
        {"events": "touchend", "update": "null"},
        {"events": "pointerdown, touchstart", "update": "xy()"}
      ]
    },
    {
      "name": "xcur",
      "value": null,
      "on": [
        {
          "events": "pointerdown, touchstart, touchend",
          "update": "slice(xdom)"
        }
      ]
    },
    {
      "name": "ycur",
      "value": null,
      "on": [
        {
          "events": "pointerdown, touchstart, touchend",
          "update": "slice(ydom)"
        }
      ]
    },
    {
      "name": "delta",
      "value": [0, 0],
      "on": [
        {
          "events": [
            {
              "source": "window", "type": "pointermove", "consume": true,
              "between": [{"type": "pointerdown"}, {"source": "window", "type": "pointerup"}]
            },
            {
              "type": "touchmove", "consume": true,
              "filter": "event.touches.length === 1"
            }
          ],
          "update": "down ? [down[0]-x(), y()-down[1]] : [0,0]"
        }
      ]
    },
    {
      "name": "anchor",
      "value": [0, 0],
      "on": [
        {
          "events": "wheel",
          "update": "[invert('x_scale', x()), invert('y_scale', y())]"
        },
        {
          "events": {"type": "touchstart", "filter": "event.touches.length===2"},
          "update": "[(xdom[0] + xdom[1]) / 2, (ydom[0] + ydom[1]) / 2]"
        }
      ]
    },
    {
      "name": "zoom",
      "value": 1,
      "on": [
        {
          "events": "wheel!",
          "force": true,
          "update": "pow(1.001, event.deltaY * pow(16, event.deltaMode))"
        },
        {
          "events": {"signal": "dist2"},
          "force": true,
          "update": "dist1 / dist2"
        }
      ]
    },
    {
      "name": "dist1",
      "value": 0,
      "on": [
        {
          "events": {"type": "touchstart", "filter": "event.touches.length===2"},
          "update": "pinchDistance(event)"
        },
        {
          "events": {"signal": "dist2"},
          "update": "dist2"
        }
      ]
    },
    {
      "name": "dist2",
      "value": 0,
      "on": [{
        "events": {"type": "touchmove", "consume": true, "filter": "event.touches.length===2"},
        "update": "pinchDistance(event)"
      }]
    },
    {
      "name": "xdom", "update": "slice(xext)",
      "on": [
        {
          "events": {"signal": "delta"},
           "update": "[xcur[0] + span(xcur) * delta[0] / width, xcur[1] + span(xcur) * delta[0] / width]"
        },
        {
          "events": {"signal": "zoom"},
          "update": "[anchor[0] + (xdom[0] - anchor[0]) * zoom, anchor[0] + (xdom[1] - anchor[0]) * zoom]"
        }
      ]
    },
    {
      "name": "ydom", "update": "slice(yext)",
      "on": [
        {
          "events": {"signal": "delta"},
          "update": "[ycur[0] + span(ycur) * delta[1] / height, ycur[1] + span(ycur) * delta[1] / height]"
        },
        {
          "events": {"signal": "zoom"},
          "update": "[anchor[1] + (ydom[0] - anchor[1]) * zoom, anchor[1] + (ydom[1] - anchor[1]) * zoom]"
        }
      ]
    },
    {
      "name": "size",
      "update": "clamp(60 / span(xdom), 60, 1000)"
    }
  ],

  "data": [
    {
      "name": "scatter_table",
      "values": {"{{REPLACE_PARAM}}": "metadata"},
      "transform": [
        { "type": "extent", "field": {"signal": "xField"}, "signal": "xext" },
        { "type": "extent", "field": {"signal": "yField"}, "signal": "yext" }
      ]
    },
    {
      "name": "line_table",
      "values": {"{{REPLACE_PARAM}}": "averaged_metadata"}
    }
  ],

  "scales": [
    {
      "name": "x_scale",
      "type": "linear",
      "range": {"signal": "xrange"},
      "zero": {"signal": "includeZero"},
      "domain": [
        {"signal": "xdom[0] - span(xdom) * 0.008"},
        {"signal": "xdom[1] + span(xdom) * 0.008"}
      ]
    },
    {
      "name": "y_scale",
      "type": "linear",
      "range": {"signal": "yrange"},
      "zero": {"signal": "includeZero"},
      "domain": [
        {"signal": "ydom[0] - span(xdom) * 0.008"},
        {"signal": "ydom[1] + span(ydom) * 0.008"}
      ]
    },
    {
      "name": "color_scale",
      "type": "ordinal",
      "range": {
        "scheme": {"signal": "colorPalette"}
      },
      "domain": {
        "data": "line_table",
        "field": {"{{REPLACE_PARAM}}": "group_by"},
        "sort": true
      }
    }
],

"axes": [
    {
      "scale": "x_scale",
      "grid": true,
      "orient": "bottom",
      "tickCount": 5,
      "title": {"{{REPLACE_PARAM}}": "x_measure"},
      "titleFontSize": 18,
      "titlePadding": 20,
      "labelFontSize": 16,
      "labelPadding": 15
    },
    {
      "scale": "y_scale",
      "grid": true,
      "orient": "left",
      "title": {"signal": "yField"},
      "titleFontSize": 18,
      "titlePadding": 20,
      "labelFontSize": 16,
      "labelPadding": 15
    }
  ],

  "legends": [
    {
      "offset": 35,
      "fill": "color_scale",
      "symbolSize": 150,
      "symbolStrokeWidth": 1.5,
      "labelFontSize": 14,
      "title": {"{{REPLACE_PARAM}}": "group_by"},
      "titleFontSize": 16,
      "encode": {
        "symbols": {
          "name": "legendSymbol",
          "interactive": false,
          "update": {
            "stroke": {"value": "black"}
          }
        },
        "labels": {
          "name": "legendLabel",
          "interactive": false
        }
      }
    }
  ],

  "marks": [
    {
      "type": "group",
      "clip": true,
      "from": {
        "facet": {
          "name": "lines",
          "data": "line_table",
          "groupby": {"{{REPLACE_PARAM}}": "group_by"}
        }
      },
      "marks": [
        {
          "type": "line",
          "from": {"data": "lines"},
          "sort": {"field": "x"},
          "encode": {
            "update": {
              "x": {
                "scale": "x_scale",
                "field": {"{{REPLACE_PARAM}}": "x_measure"}
              },
              "y": {
                "scale": "y_scale",
                "field": {"signal": "yField"}},
              "interpolate": {"signal": "lineType"},
              "stroke": {
                "scale": "color_scale",
                "field": {"{{REPLACE_PARAM}}": "group_by"}
              },
              "strokeWidth": {"value": 2.5},
              "strokeOpacity": {"value": 1}
            }
          }
        }
      ]
    },
    {
      "type": "symbol",
      "clip": true,
      "from": {"data": "scatter_table"},
      "encode": {
        "update": {
          "x": {
            "scale": "x_scale",
            "field": {"{{REPLACE_PARAM}}": "x_measure"}
          },
          "y": {
            "scale": "y_scale",
            "field": {"signal": "yField"}
          },
          "shape": {"value": "circle"},
          "stroke": {"value": "black"},
          "strokeWidth": {"value": 1.5},
          "size": {"signal": "markSize"},
          "fill": {
            "scale": "color_scale",
            "field": {"{{REPLACE_PARAM}}": "group_by"}
          }
        },
        "hover": {
          "strokeWidth": {"value": 2.5},
          "tooltip": {"signal": "datum"}
        }
      }
    }
  ]
}
