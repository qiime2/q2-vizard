{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "title": {
    "text": {"signal": "title"},
    "fontSize": 20,
    "orient": "top",
    "anchor": "start",
    "subtitle": " ",
    "subtitlePadding": 30
  },
  "autosize": {
    "type": "pad",
    "resize": true
  },
  "width": 900,
  "height": 900,
  "padding": 20,

  "signals": [
    {
      "name": "title",
      "value": {"{{REPLACE_PARAM}}": "title"},
      "bind": {"input": "input"}
    },
    {
      "name": "colorBy",
      "value": {"{{REPLACE_PARAM}}": "group_dropdown_default"},
      "bind": {
        "input": "select",
        "options": {"{{REPLACE_PARAM}}": "md_cols_categorical"}
      }
    },
    {
      "name": "colorPalette",
      "value": "Viridis",
      "bind": {
        "input": "select",
        "options": [
          "Viridis", "Cividis", "Plasma", "Turbo",
          "category10", "dark2", "set1", "tableau10"
        ]
      }
    },
    {
      "name": "idField",
      "value": {"{{REPLACE_PARAM}}": "md_ids"}
    },
    {
      "name": "xField",
      "value": {"{{REPLACE_PARAM}}": "x_dropdown_default"},
      "bind": {
        "input": "select",
        "options": {"{{REPLACE_PARAM}}": "md_cols_numeric"}
      }
    },
    {
      "name": "yField",
      "value": {"{{REPLACE_PARAM}}": "y_dropdown_default"},
      "bind": {
        "input": "select",
        "options": {"{{REPLACE_PARAM}}": "md_cols_numeric"}
      }
    }
  ],

  "data": [
    {
      "name": "table",
      "values": {"{{REPLACE_PARAM}}": "metadata"}
    }
  ],

  "scales": [
    {
      "name": "x_scale",
      "type": "linear",
      "range": "width",
      "nice": true,
      "zero": true,
      "domain": {
        "data": "table",
        "field": {"signal": "xField"}
      }
    },
    {
      "name": "y_scale",
      "type": "linear",
      "range": "height",
      "nice": true,
      "zero": true,
      "domain": {
        "data": "table",
        "field": {"signal": "yField"}
      }
    },
    {
      "name": "color_scale",
      "type": "ordinal",
      "range": {
        "scheme": {"signal": "colorPalette"}
      },
      "domain": {
        "data": "table",
        "field": {"signal": "colorBy"},
        "sort": true
      }
    }
  ],

  "axes": [
    {
      "scale": "x_scale",
      "labelFontSize": 12,
      "grid": true,
      "orient": "bottom",
      "tickCount": 5,
      "title": {"signal": "xField"},
      "titleFontSize": 14,
      "titlePadding": 20
    },
    {
      "scale": "y_scale",
      "labelFontSize": 12,
      "grid": true,
      "orient": "left",
      "title": {"signal": "yField"},
      "titleFontSize": 14,
      "titlePadding": 20
    }
  ],

  "legends": [
    {
      "fill": "color_scale",
      "symbolSize": 150,
      "symbolStrokeWidth": 1.5,
      "labelFontSize": 14,
      "title": {"signal": "colorBy"},
      "titleFontSize": 16,
      "encode": {
        "symbols": {
          "name": "legendSymbol",
          "interactive": false,
          "update": {
            "stroke": {"value": "black"}
          }
        },
        "labels": {
          "name": "legendLabel",
          "interactive": false
        }
      }
    }
  ],

  "marks": [
    {
      "name": "marks",
      "type": "symbol",
      "from": {"data": "table"},
      "encode": {
        "update": {
          "x": {
            "scale": "x_scale",
            "field": {"signal": "xField"}
          },
          "y": {
            "scale": "y_scale",
            "field": {"signal": "yField"}},
          "shape": {"value": "circle"},
          "strokeWidth": {"value": 1.5},
          "size": {"value": 150},
          "stroke": {"value": "black"},
          "fill": {
            "scale": "color_scale",
            "field": {"signal": "colorBy"}
          }
        },
        "hover": {
          "stroke": {
            "scale": "color_scale",
            "field": {"signal": "colorBy"}
          },
          "tooltip": {"signal": "datum"}
        }
      }
    }
  ]
}
