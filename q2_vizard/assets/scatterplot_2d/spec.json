{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "title": {
    "text": {"signal": "title"},
    "fontSize": 20,
    "orient": "top",
    "anchor": "start",
    "subtitle": " ",
    "subtitlePadding": 30
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 100,

  "signals": [
    {
      "name": "width",
      "init": "isFinite(containerSize()[0]) ? containerSize()[0] : 300",
      "on": [
        {
          "update": "isFinite(containerSize()[0]) ? containerSize()[0] : 300",
          "events": "window:resize"
        }
      ]
    },
    {
      "name": "height",
      "init": "isFinite(containerSize()[1]) ? containerSize()[1] : 600",
      "on": [
        {
          "update": "isFinite(containerSize()[1]) ? containerSize()[1] : 600",
          "events": "window:resize"
        }
      ]
    },
    {
      "name": "unit",
      "value": {},
      "on": [
        {
          "events": "mousemove",
          "update": "isTuple(group()) ? group() : unit"
        }
      ]
    },
    {
      "name": "grid_value",
      "on": [
        {
          "events": [
            {"source": "view", "type": "dblclick"},
            {"signal": "includeZero"}
          ],
          "update": "null"
        },
        {
          "events": {"signal": "grid_translate_delta"},
          "update": "panLinear(grid_translate_anchor.extent_x, -grid_translate_delta.x / width)"
        },
        {
          "events": {"signal": "grid_zoom_delta"},
          "update": "zoomLinear(domain(\"x_scale\"), grid_zoom_anchor.x, grid_zoom_delta)"
        }
      ]
    },
    {
      "name": "grid_translate_anchor",
      "value": {},
      "on": [
        {
          "events": [{"source": "view", "type": "mousedown"}],
          "update": "{x: x(unit), extent_x: domain(\"x_scale\")}"
        }
      ]
    },
    {
      "name": "grid_translate_delta",
      "value": {},
      "on": [
        {
          "events": [
            {
              "source": "window",
              "type": "mousemove",
              "consume": true,
              "between": [
                {"source": "view", "type": "mousedown"},
                {"source": "window", "type": "mouseup"}
              ]
            }
          ],
          "update": "{x: grid_translate_anchor.x - x(unit)}"
        }
      ]
    },
    {
      "name": "grid_zoom_anchor",
      "on": [
        {
          "events": [
            {
              "source": "view",
              "type": "wheel",
              "consume": true
            }
          ],
          "update": "{x: invert(\"x_scale\", x(unit))}"
        }
      ]
    },
    {
      "name": "grid_zoom_delta",
      "on": [
        {
          "events": [
            {
              "source": "view",
              "type": "wheel",
              "consume": true
            }
          ],
          "force": true,
          "update": "pow(1.001, event.deltaY * pow(16, event.deltaMode))"
        }
      ]
    },
    {
      "name": "idField",
      "value": {"{{REPLACE_PARAM}}": "md_ids"}
    },
    {
      "name": "title",
      "value": {"{{REPLACE_PARAM}}": "title"},
      "bind": {"input": "input"}
    },
    {
      "name": "xField",
      "value": {"{{REPLACE_PARAM}}": "x_dropdown_default"},
      "bind": {
        "input": "select",
        "options": {"{{REPLACE_PARAM}}": "md_cols_numeric"}
      }
    },
    {
      "name": "yField",
      "value": {"{{REPLACE_PARAM}}": "y_dropdown_default"},
      "bind": {
        "input": "select",
        "options": {"{{REPLACE_PARAM}}": "md_cols_numeric"}
      }
    },
    {
      "name": "markSize",
      "value": 150,
      "bind": {
        "input": "range",
        "min": 150,
        "max": 800
      }
    },
    {
      "name": "includeZero",
      "value": true,
      "bind": {"input": "checkbox"}
    },
    {
      "name": "colorBy",
      "value": {"{{REPLACE_PARAM}}": "group_dropdown_default"},
      "bind": {
        "input": "select",
        "options": {"{{REPLACE_PARAM}}": "md_cols_categorical"}
      }
    },
    {
      "name": "colorPalette",
      "value": "category10",
      "bind": {
        "input": "select",
        "options": [
          "Viridis", "Cividis", "Plasma", "Turbo",
          "category10", "dark2", "set1", "tableau10"
        ]
      }
    }
  ],

  "data": [
    {
      "name": "table",
      "values": {"{{REPLACE_PARAM}}": "metadata"}
    }
  ],

  "scales": [
    {
      "name": "x_scale",
      "type": "linear",
      "range": "width",
      "nice": true,
      "zero": {"signal": "includeZero"},
      "domainRaw": {"signal": "grid_value"},
      "domain": {
        "data": "table",
        "field": {"signal": "xField"}
      }
    },
    {
      "name": "y_scale",
      "type": "linear",
      "range": "height",
      "nice": true,
      "zero": {"signal": "includeZero"},
      "domain": {
        "data": "table",
        "field": {"signal": "yField"}
      }
    },
    {
      "name": "color_scale",
      "type": "ordinal",
      "range": {
        "scheme": {"signal": "colorPalette"}
      },
      "domain": {
        "data": "table",
        "field": {"signal": "colorBy"},
        "sort": true
      }
    }
  ],

  "axes": [
    {
      "scale": "x_scale",
      "grid": true,
      "orient": "bottom",
      "tickCount": 5,
      "title": {"signal": "xField"},
      "titleFontSize": 18,
      "titlePadding": 20,
      "labelFontSize": 16,
      "labelPadding": 15
    },
    {
      "scale": "y_scale",
      "grid": true,
      "orient": "left",
      "title": {"signal": "yField"},
      "titleFontSize": 18,
      "titlePadding": 20,
      "labelFontSize": 16,
      "labelPadding": 15
    }
  ],

  "legends": [
    {
      "offset": 35,
      "fill": "color_scale",
      "symbolSize": 150,
      "symbolStrokeWidth": 1.5,
      "labelFontSize": 14,
      "title": {"signal": "colorBy"},
      "titleFontSize": 16,
      "encode": {
        "symbols": {
          "name": "legendSymbol",
          "interactive": false,
          "update": {
            "stroke": {"value": "black"}
          }
        },
        "labels": {
          "name": "legendLabel",
          "interactive": false
        }
      }
    }
  ],

  "marks": [
    {
      "name": "marks",
      "clip": true,
      "type": "symbol",
      "from": {"data": "table"},
      "encode": {
        "update": {
          "x": {
            "scale": "x_scale",
            "field": {"signal": "xField"}
          },
          "y": {
            "scale": "y_scale",
            "field": {"signal": "yField"}},
          "shape": {"value": "circle"},
          "strokeWidth": {"value": 1.5},
          "size": {"signal": "markSize"},
          "stroke": {"value": "black"},
          "fill": {
            "scale": "color_scale",
            "field": {"signal": "colorBy"}
          }
        },
        "hover": {
          "strokeWidth": {"value": 2.5},
          "tooltip": {"signal": "datum"}
        }
      }
    }
  ]
}
