{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "title": {
    "text": {"signal": "title"},
    "limit": 900,
    "fontSize": 20,
    "orient": "top",
    "anchor": "start",
    "subtitle": " "
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 100,

  "signals": [
    {
      "name": "width",
      "init": "isFinite(containerSize()[0]) ? containerSize()[0] : 300",
      "on": [
        {
          "update": "isFinite(containerSize()[0]) ? containerSize()[0] : 300",
          "events": "window:resize"
        }
      ]
    },
    {
      "name": "height",
      "init": "isFinite(containerSize()[1]) ? containerSize()[1] : 600",
      "on": [
        {
          "update": "isFinite(containerSize()[1]) ? containerSize()[1] : 600",
          "events": "window:resize"
        }
      ]
    },
    {
      "name": "idField",
      "value": {"{{REPLACE_PARAM}}": "md_ids"}
    },
    {
      "name": "title",
      "value": {"{{REPLACE_PARAM}}": "title"},
      "bind": {"input": "input"}
    },
    {
      "name": "xField",
      "value": {"{{REPLACE_PARAM}}": "x_dropdown_default"},
      "bind": {
        "input": "select",
        "options": {"{{REPLACE_PARAM}}": "md_cols_numeric"}
      }
    },
    {
      "name": "yField",
      "value": {"{{REPLACE_PARAM}}": "y_dropdown_default"},
      "bind": {
        "input": "select",
        "options": {"{{REPLACE_PARAM}}": "md_cols_numeric"}
      }
    },
    {
      "name": "markSize",
      "value": 150,
      "bind": {
        "input": "range",
        "min": 150,
        "max": 800
      }
    },
    {
      "name": "includeZero",
      "value": true,
      "bind": {"input": "checkbox"}
    },
    {
      "name": "colorBy",
      "value": {"{{REPLACE_PARAM}}": "group_dropdown_default"},
      "bind": {
        "input": "select",
        "options": {"{{REPLACE_PARAM}}": "md_cols_color"}
      }
    },
    {
      "name": "numericColorFields",
      "value": {"{{REPLACE_PARAM}}": "md_cols_numeric"}
    },
    {
      "name": "isNumericColorField",
      "update": "indexof(numericColorFields, colorBy) >= 0"
    },
    {
      "name": "colorPalette",
      "value": "category10",
      "bind": {
        "input": "select",
        "options": [
          "category10", "category20", "category20c",
          "dark2", "set1", "tableau10", "tableau20"
        ]
      }
    }
  ],

  "data": [
    {
      "name": "table",
      "values": {"{{REPLACE_PARAM}}": "metadata"}
    }
  ],

  "scales": [
    {
      "name": "x_scale",
      "type": "linear",
      "range": "width",
      "nice": true,
      "zero": {"signal": "includeZero"},
      "domain": {
        "data": "table",
        "field": {"signal": "xField"}
      }
    },
    {
      "name": "y_scale",
      "type": "linear",
      "range": "height",
      "nice": true,
      "zero": {"signal": "includeZero"},
      "domain": {
        "data": "table",
        "field": {"signal": "yField"}
      }
    },
    {
      "name": "categorical_color_scale",
      "type": "ordinal",
      "range": {
        "scheme": {"signal": "colorPalette"}
      },
      "domain": {
        "data": "table",
        "field": {"signal": "colorBy"},
        "sort": true
      }
    },
    {
      "name": "continuous_color_scale",
      "type": "linear",
      "range": {
        "scheme": {"signal": "colorPalette"}
      },
      "domain": {
        "data": "table",
        "field": {"signal": "colorBy"}
      },
      "zero": false,
      "nice": true
    }
  ],

  "axes": [
    {
      "scale": "x_scale",
      "grid": true,
      "orient": "bottom",
      "tickCount": 5,
      "title": {"signal": "xField"},
      "titleFontSize": 18,
      "titlePadding": 20,
      "labelFontSize": 16,
      "labelPadding": 15
    },
    {
      "scale": "y_scale",
      "grid": true,
      "orient": "left",
      "title": {"signal": "yField"},
      "titleFontSize": 18,
      "titlePadding": 20,
      "labelFontSize": 16,
      "labelPadding": 15
    }
  ],

  "legends": [
    {
      "offset": 35,
      "fill": "categorical_color_scale",
      "symbolSize": 150,
      "symbolStrokeWidth": 1.5,
      "labelFontSize": 14,
      "labelLimit": 900,
      "title": {"signal": "colorBy"},
      "titleFontSize": 16,
      "encode": {
        "symbols": {
          "name": "legendSymbol",
          "interactive": false,
          "update": {
            "stroke": {"value": "black"}
          }
        },
        "labels": {
          "name": "legendLabel",
          "interactive": false
        }
      }
    },
    {
      "offset": 35,
      "fill": "continuous_color_scale",
      "type": "gradient",
      "title": {"signal": "colorBy"},
      "titleFontSize": 16,
      "titlePadding": 4,
      "gradientLength": 200
    }
  ],

  "marks": [
    {
      "name": "marks",
      "type": "symbol",
      "from": {"data": "table"},
      "encode": {
        "update": {
          "x": {
            "scale": "x_scale",
            "field": {"signal": "xField"}
          },
          "y": {
            "scale": "y_scale",
            "field": {"signal": "yField"}},
          "shape": {"value": "circle"},
          "strokeWidth": {"value": 1.5},
          "size": {"signal": "markSize"},
          "stroke": {"value": "black"},
          "fill": {
            "signal": "isNumericColorField ? (isValid(datum[colorBy]) ? scale('continuous_color_scale', datum[colorBy]) : '#808080') : scale('categorical_color_scale', datum[colorBy])"
          }
        },
        "hover": {
          "strokeWidth": {"value": 2.5},
          "tooltip": {"signal": "datum"}
        }
      }
    }
  ]
}
