{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "title": {
    "text": {"signal": "title"},
    "limit": 900,
    "fontSize": 20,
    "orient": "top",
    "anchor": "start",
    "subtitle": " "
  },
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "padding": 100,

  "signals": [
    {
      "name": "plotSize",
      "value": 400
    },
    {
      "name": "width",
      "update": "plotSize"
    },
    {
      "name": "height",
      "update": "plotSize"
    },
    {
      "name": "idField",
      "value": {"{{REPLACE_PARAM}}": "md_ids"}
    },
    {
      "name": "title",
      "value": {"{{REPLACE_PARAM}}": "title"},
      "bind": {"input": "input"}
    },
    {
      "name": "xField",
      "value": {"{{REPLACE_PARAM}}": "x_dropdown_default"},
      "bind": {
        "input": "select",
        "options": {"{{REPLACE_PARAM}}": "md_cols_numeric_in_range"}
      }
    },
    {
      "name": "yField",
      "value": {"{{REPLACE_PARAM}}": "y_dropdown_default"},
      "bind": {
        "input": "select",
        "options": {"{{REPLACE_PARAM}}": "md_cols_numeric_in_range"}
      }
    },
    {
      "name": "markSize",
      "value": 150,
      "bind": {
        "input": "range",
        "min": 150,
        "max": 800
      }
    },
    {
      "name": "colorBy",
      "value": {"{{REPLACE_PARAM}}": "group_dropdown_default"},
      "bind": {
        "input": "select",
        "options": {"{{REPLACE_PARAM}}": "md_cols_color"}
      }
    },
    {
      "name": "numericCols",
      "value": {"{{REPLACE_PARAM}}": "md_cols_numeric"}
    },
    {
      "name": "colorIsNumeric",
      "update": "indexof(numericCols, colorBy) >= 0"
    },
    {
      "name": "colorFieldCategorical",
      "update": "colorIsNumeric ? 'legendDefault' : colorBy"
    },
    {
      "name": "colorFieldNumeric",
      "update": "colorIsNumeric ? colorBy : xField"
    },
    {
      "name": "discretePalette",
      "value": "category10",
      "bind": {
        "input": "select",
        "options": [
          "Viridis", "Cividis", "Plasma", "Turbo",
          "category10", "category20", "category20c",
          "dark2", "set1", "tableau10", "tableau20"
        ]
      }
    },
    {
      "name": "continuousPalette",
      "value": "Viridis",
      "bind": {
        "input": "select",
        "options": [
          "Viridis", "Cividis", "Magma",
          "Plasma", "Inferno", "Turbo", "Greys"
        ]
      }
    }
  ],

  "data": [
    {
      "name": "table",
      "values": {"{{REPLACE_PARAM}}": "metadata"}
    }
  ],

  "scales": [
    {
      "name": "x_scale",
      "type": "linear",
      "range": "width",
      "nice": true,
      "domain": [-1, 1]
    },
    {
      "name": "y_scale",
      "type": "linear",
      "range": "height",
      "nice": true,
      "domain": [-1, 1]
    },
    {
      "name": "color_scale_categorical",
      "type": "ordinal",
      "range": {
        "scheme": {"signal": "discretePalette"}
      },
      "domain": {
        "data": "table",
        "field": {"signal": "colorFieldCategorical"},
        "sort": true
      }
    },
    {
      "name": "color_scale_numeric",
      "type": "linear",
      "range": {
        "scheme": {"signal": "continuousPalette"}
      },
      "domain": {
        "data": "table",
        "field": {"signal": "colorFieldNumeric"}
      },
      "zero": false,
      "nice": true
    }
  ],

  "axes": [
    {
      "scale": "x_scale",
      "orient": "bottom",
      "title": {"signal": "xField"},
      "titleFontSize": 18,
      "titlePadding": 20,
      "labelFontSize": 16,
      "labelPadding": 15,
      "domainCap": "square"
    },
    {
      "scale": "y_scale",
      "orient": "left",
      "title": {"signal": "yField"},
      "titleFontSize": 18,
      "titlePadding": 20,
      "labelFontSize": 16,
      "labelPadding": 15,
      "domainCap": "square"
    }
  ],

  "legends": [
    {
      "name": "categoricalLegend",
      "offset": 35,
      "fill": "color_scale_categorical",
      "symbolSize": {"signal": "colorIsNumeric ? 0 : 150"},
      "symbolStrokeWidth": 1.5,
      "labelFontSize": {"signal": "colorIsNumeric ? 0 : 14"},
      "labelLimit": 900,
      "title": {"signal": "colorIsNumeric ? '' : colorBy"},
      "titleFontSize": {"signal": "colorIsNumeric ? 0 : 16"},
      "encode": {
        "legend": {
          "update": {
            "opacity": {"signal": "colorIsNumeric ? 0 : 1"}
          }
        },
        "symbols": {
          "name": "legendSymbol",
          "interactive": false,
          "update": {
            "stroke": {"value": "black"}
          }
        },
        "labels": {
          "name": "legendLabel",
          "interactive": false
        }
      }
    },
    {
      "name": "numericLegend",
      "type": "gradient",
      "offset": 35,
      "fill": "color_scale_numeric",
      "gradientLength": {"signal": "colorIsNumeric ? height * 0.5 : 0"},
      "gradientThickness": {"signal": "colorIsNumeric ? 16 : 0"},
      "labelFontSize": {"signal": "colorIsNumeric ? 14 : 0"},
      "labelLimit": 900,
      "title": {"signal": "colorIsNumeric ? colorBy : ''"},
      "titleFontSize": {"signal": "colorIsNumeric ? 16 : 0"},
      "titleLimit": 900,
      "encode": {
        "legend": {
          "update": {
            "opacity": {"signal": "colorIsNumeric ? 1 : 0"}
          }
        }
      }
    }
  ],

  "marks": [
    {
      "name": "x_line",
      "type": "rule",
      "encode": {
        "update": {
          "x": {"scale": "x_scale", "value": -1},
          "x2": {"scale": "x_scale", "value": 1},
          "y": {"scale": "y_scale", "value": 0},
          "stroke": {"value": "black"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "name": "y_line",
      "type": "rule",
      "encode": {
        "update": {
          "y": {"scale": "y_scale", "value": -1},
          "y2": {"scale": "y_scale", "value": 1},
          "x": {"scale": "x_scale", "value": 0},
          "stroke": {"value": "black"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "name": "marks",
      "type": "symbol",
      "from": {"data": "table"},
      "encode": {
        "update": {
          "x": {
            "scale": "x_scale",
            "field": {"signal": "xField"}
          },
          "y": {
            "scale": "y_scale",
            "field": {"signal": "yField"}},
          "shape": {"value": "circle"},
          "strokeWidth": {"value": 1.5},
          "size": {"signal": "markSize"},
          "stroke": {"value": "black"},
          "fill": [
            {
              "test": "colorIsNumeric",
              "scale": "color_scale_numeric",
              "field": {"signal": "colorBy"}
            },
            {
              "scale": "color_scale_categorical",
              "field": {"signal": "colorBy"}
            }
          ]
        },
        "hover": {
          "strokeWidth": {"value": 2.5},
          "tooltip": {"signal": "datum"}
        }
      }
    }
  ]
}
